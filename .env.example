# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.

# --- AI engine (Tier 3) ---
# Primary LLM engine. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq model (see https://console.groq.com/docs/models). Leave blank to use the app default.
GROQ_MODEL=

# Optional Claude enhancement. If set, adds Claude-powered scoring/rationale.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Scoring weights (0..1, should sum to ~1.0) ---
WEIGHT_SKILLS=0.5
WEIGHT_SIMILARITY=0.3
WEIGHT_KEYWORDS=0.2

# When an LLM tier is active, how much to blend the LLM score vs offline score (0..1)
LLM_BLEND=0.5

# --- Server ---
MAX_UPLOAD_MB=10
